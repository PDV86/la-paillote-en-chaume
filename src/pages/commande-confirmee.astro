---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Commande confirmée | SEREPI – La paillote en chaume" description="Merci pour votre commande de tuiles de chaume SEREPI. Un e-mail de confirmation vous a été envoyé ; la commande est expédiée sous 8 jours sur palette." path="/commande-confirmee/" noindex>
  <section class="sec" data-clear-cart><div class="wrap narrow center">
    <span class="sc">Paiement reçu</span>
    <h1 class="t" style="margin:12px 0 18px">Merci pour votre commande</h1>
    <p>Un e-mail de confirmation vous a été envoyé. Votre commande est expédiée sous 8 jours, sur palette filmée.</p>
    <div class="ctas" style="justify-content:center;margin-top:24px"><a class="btn line" href={u('/conseils/poser-des-tuiles-de-chaume/')}>Préparer la pose</a></div>
  </div></section>
</Base>
