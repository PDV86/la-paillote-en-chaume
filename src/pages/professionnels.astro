---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Img from '../components/Img.astro';
import Brief from '../components/Brief.astro';
import Faq from '../components/Faq.astro';
import { REFS, SITE } from '../data/site';
import { FAQ_COMMANDE, FAQ_PAILLOTE } from '../data/faq';
import { faqLd } from '../lib/seo';
import { u } from '../lib/url';
const path = '/professionnels/';
const faq = [FAQ_COMMANDE[2], FAQ_PAILLOTE[1], FAQ_COMMANDE[4], FAQ_COMMANDE[3]];
---
<Base title="Paillotes en chaume pour campings, plages et hôtels | SEREPI" description="Paillotes et tuiles de chaume pour campings, bars de plage, parcs, résidences et golfs : prix HT, tuiles de rechange sous 8 jours, devis dès 4 paillotes." path={path} crumbs={[{ name: 'Professionnels', path }]} ld={[faqLd(faq), { '@type': 'Service', name: 'Paillotes en chaume pour les professionnels', serviceType: 'Fourniture de paillotes et de tuiles de chaume', provider: { '@id': `${SITE.url}/#organization` }, areaServed: { '@type': 'Country', name: 'France' }, audience: { '@type': 'BusinessAudience', name: 'Campings, bars de plage, parcs de loisirs, résidences hôtelières, golfs' } }]}>
  <PageHead crumbs={[{ name: 'Professionnels', path }]} kicker="Professionnels" title="Paillotes en chaume pour les professionnels" lead="Campings, bars de plage, parcs de loisirs, résidences hôtelières, golfs : SEREPI équipe vos espaces extérieurs de paillotes qui tiennent au vent, et fournit les tuiles de rechange pour renouveler leur chaume sans toucher à la structure.">
    <Brief items={['Prix hors taxes : choisissez « Pro » en haut de page', 'Devis dédié à partir de 4 paillotes', 'Tuiles de rechange en ligne, expédiées sous 8 jours', 'Facture avec TVA, paiement par carte ou par virement']} />
  </PageHead>
  <section class="band" aria-label="Paillotes en terrasse">
    <Img name="paillote-terrasse-oliviers" alt="Paillote en chaume sur une terrasse en bois, au milieu des oliviers" sizes="100vw" />
    <div class="wrap"><div class="txt">
      <span class="hand">Vos clients à l’ombre</span>
      <h2 class="t">Un devis établi pour votre site</h2>
      <p>Établissement, modèles, quantités, lieu, délai et photos : nous établissons un tarif et un délai adaptés à votre volume.</p>
      <div class="ctas"><a class="btn gold" href={u('/devis/?profil=pro')}>Demande de devis professionnel</a></div>
    </div></div>
  </section>
  <section class="sec"><div class="wrap grid3">
    <div class="card"><span class="sc">Robustes</span><h2 class="t" style="font-size:20px;margin:0">Une structure qui tient au vent</h2><p>Structures en acier ou en aluminium, mâts en pin traité autoclave classe 4 de forte section, conçus pour résister à des vents violents.</p></div>
    <div class="card"><span class="sc">Durables</span><h2 class="t" style="font-size:20px;margin:0">Un chaume qui se change pièce par pièce</h2><p>Tuiles de rechange expédiées sous 8 jours ; le remplacement se fait sans toucher à la structure, tuile par tuile si besoin.</p></div>
    <div class="card"><span class="sc">Sur mesure du volume</span><h2 class="t" style="font-size:20px;margin:0">Un tarif dès 4 paillotes</h2><p>Campings 3 à 5 étoiles, bars de plage, parcs, résidences hôtelières, golfs : tarif et délai établis pour votre volume.</p></div>
  </div></section>
  <section class="sec creme"><div class="wrap two">
    <div>
      <span class="sc">Ils ont équipé leurs sites</span>
      <h2 class="t">Nos références</h2>
      <ul class="refs" style="margin-top:20px">{REFS.map((r) => <li>{r}</li>)}</ul>
      <p class="small muted" style="margin-top:16px">Références clients du site actuel <span class="todo">[À VALIDER : références toujours d’actualité et accord pour les citer]</span></p>
    </div>
    <div>
      <span class="sc">Commander en tant que professionnel</span>
      <h2 class="t">Comment ça se passe</h2>
      <ol class="steps" style="margin-top:20px">
        <li><b>Prix hors taxes</b>Sélectionnez « Pro » : tous les prix du site passent en HT, panier compris.</li>
        <li><b>Commande en ligne</b>Tuiles, cônes et tuiles d’angle : raison sociale et SIRET à la commande, facture avec TVA.</li>
        <li><b>Projet d’équipement</b>Paillotes complètes ou gros volumes : demande de devis, réponse avec tarif et délai.</li>
      </ol>
    </div>
  </div></section>
  <section class="sec"><div class="wrap narrow"><h2 class="t">Questions des professionnels</h2><Faq items={faq} open /></div></section>
</Base>
