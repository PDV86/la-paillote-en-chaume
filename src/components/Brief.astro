---
// Points clés d'un guide, en tête d'article (réponse directe, utile aux lecteurs pressés et aux assistants IA).
import { rich } from '../lib/text';
interface Props { items: string[]; title?: string }
const { items, title = 'L’essentiel' } = Astro.props;
---
<div class="keypoints"><p class="kp">{title}</p><ul>{items.map((i) => <li set:html={rich(i)} />)}</ul></div>
