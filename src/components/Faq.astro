---
import { rich } from '../lib/text';
interface Props { items: readonly (readonly [string, string])[]; open?: boolean }
const { items, open = false } = Astro.props;
---
<div class="faq">{items.map(([q, a], i) => <details open={open && i === 0}><summary>{q}</summary><p set:html={rich(a)} /></details>)}</div>
