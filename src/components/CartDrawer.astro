---
import { u } from '../lib/url';
---
<div class="drawer" data-drawer hidden>
  <div class="panel" role="dialog" aria-modal="true" aria-labelledby="cart-title">
    <header><h2 id="cart-title" class="t" style="font-size:20px;margin:0">Votre panier</h2><button type="button" class="ibtn" data-close-cart aria-label="Fermer le panier"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg></button></header>
    <div class="body" data-cart-lines></div>
    <footer>
      <div data-cart-totals></div>
      <a class="btn solid block" href={u('/commande/')} data-cart-go>Commander</a>
      <a class="btn line block sm" href={u('/panier/')}>Voir le panier</a>
    </footer>
  </div>
</div>
<figure class="lb" data-lb hidden role="dialog" aria-modal="true" aria-label="Photo agrandie">
  <img alt="" data-lb-img />
  <figcaption data-lb-cap></figcaption>
  <button type="button" class="x" data-lb-close aria-label="Fermer">×</button>
  <button type="button" class="prev" data-lb-prev aria-label="Photo précédente">‹</button>
  <button type="button" class="next" data-lb-next aria-label="Photo suivante">›</button>
</figure>
