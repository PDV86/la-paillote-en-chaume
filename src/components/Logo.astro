---
// Logotype officiel « Paillotes en chaume · SEREPI » (dossier Identité visuelle, charte graphique 2026).
// Fichiers repris tels quels : jamais redessiné ni recomposé. Écran : 120 px de large minimum,
// en dessous on emploie le symbole seul (symbole-serepi.svg).
import { u } from '../lib/url';
interface Props { variant?: 'principal' | 'clair'; width?: number; link?: boolean; eager?: boolean }
const { variant = 'principal', width = 136, link = true, eager = false } = Astro.props;
const src = u(variant === 'clair' ? '/images/logo-serepi-clair.svg' : '/images/logo-serepi.svg');
const height = Math.round((width * 123.5) / 136);
const img = `<img src="${src}" width="${width}" height="${height}" alt="Paillotes en chaume SEREPI" class="logo-img" loading="${eager ? 'eager' : 'lazy'}" decoding="async" />`;
---
{link ? <a href={u('/')} class="logo" aria-label="Paillotes en chaume SEREPI, accueil" set:html={img} /> : <span class="logo" set:html={img} />}
