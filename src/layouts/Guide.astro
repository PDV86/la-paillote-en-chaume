---
import Base from './Base.astro';
import PageHead from '../components/PageHead.astro';
import Brief from '../components/Brief.astro';
import Faq from '../components/Faq.astro';
import Img from '../components/Img.astro';
import { GUIDES, GUIDES_DATE } from '../data/guides';
import { articleLd, faqLd, howToLd } from '../lib/seo';
import { IMAGES } from '../data/images';
import { u } from '../lib/url';
interface Props { slug: string; title: string; h1: string; description: string; lead: string; brief: string[]; faq?: (readonly [string, string])[]; howto?: { name: string; description: string; steps: { name: string; text: string }[]; supply?: string[]; tool?: string[] } }
const { slug, title, h1, description, lead, brief, faq = [], howto } = Astro.props;
const path = `/conseils/${slug}/`;
const g = GUIDES.find((x) => x.slug === slug)!;
const img = `/images/${g.img}-${IMAGES[g.img].widths[IMAGES[g.img].widths.length - 1]}.webp`;
const crumbs = [{ name: 'Conseils', path: '/conseils/' }, { name: g.title, path }];
const ld: object[] = [articleLd({ path, title: h1, description, image: img, datePublished: GUIDES_DATE.published, dateModified: GUIDES_DATE.modified })];
if (faq.length) ld.push(faqLd(faq));
if (howto) ld.push(howToLd({ path, ...howto }));
const others = GUIDES.filter((x) => x.slug !== slug);
---
<Base title={title} description={description} path={path} pageType="WebPage" crumbs={crumbs} image={img} ld={ld} dateModified={GUIDES_DATE.modified}>
  <PageHead crumbs={crumbs} kicker="Conseils" title={h1} lead={lead} updated={GUIDES_DATE.modified}><Brief items={brief} /></PageHead>
  <article class="sec tight" style="padding-top:8px"><div class="wrap narrow prose">
    <figure class="figure" style="margin-bottom:28px"><Img name={g.img} alt={g.title} sizes="(max-width:820px) 100vw, 780px" style="aspect-ratio:16/9;object-fit:cover" /></figure>
    <slot />
    <p style="margin-top:28px" class="small muted">Guide rédigé par SEREPI - La paillote en chaume.</p>
  </div></article>
  {faq.length > 0 && <section class="sec creme"><div class="wrap narrow"><h2 class="t">Questions fréquentes</h2><Faq items={faq} open /></div></section>}
  <section class="sec"><div class="wrap">
    <h2 class="t">À lire aussi</h2>
    <div class="grid3">{others.map((o) => <a class="card link" href={u(`/conseils/${o.slug}/`)}><h3 class="t" style="font-size:17px;margin:0">{o.title}</h3><p class="small muted">{o.short}</p><span class="arrow">Lire</span></a>)}</div>
  </div></section>
</Base>
