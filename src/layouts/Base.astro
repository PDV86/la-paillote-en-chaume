---
import '@fontsource/dm-sans/latin-300.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/dm-serif-display/latin-400.css';
import '@fontsource/dm-sans/latin-600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import { SITE } from '../data/site';
import { PRODUCTS, TVA } from '../data/catalogue';
import { IMAGES } from '../data/images';
import { abs, orgGraph, breadcrumbLd, webPageLd, type Crumb } from '../lib/seo';
import { u, PREVIEW } from '../lib/url';

interface Props {
  title: string;          // balise <title> (≤ 65 caractères)
  description: string;    // meta description (120 à 160 caractères)
  path: string;           // chemin canonique, slash final
  image?: string;         // image Open Graph
  noindex?: boolean;      // panier, commande… : hors index et hors sitemap
  over?: boolean;         // en-tête transparent sur la photo d'accueil
  crumbs?: Crumb[];
  pageType?: string;
  ld?: object[];
  dateModified?: string;
}
const { title, description, path, image = SITE.ogImage, noindex = false, over = false, crumbs = [], pageType = 'WebPage', ld = [], dateModified } = Astro.props;
const canonical = abs(path);
const fullCrumbs = path === '/' ? [{ name: 'Accueil', path: '/' }] : [{ name: 'Accueil', path: '/' }, ...crumbs];
const graph = [...orgGraph(), webPageLd({ path, title, description, type: pageType, image, dateModified }), breadcrumbLd(fullCrumbs), ...ld];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
const shopData = JSON.stringify({
  base: u('/'),
  tva: TVA,
  preview: PREVIEW,
  products: PRODUCTS.map((p) => ({
    id: p.id, name: p.cartName, unitHT: p.unitHT, tier: p.tier ?? null, url: u(`/tuiles-de-chaume/${p.slug}/`),
    img: p.image ? u(`/images/${p.image}-${IMAGES[p.image].widths[0]}.webp`) : null,
  })),
});
const robots = noindex || PREVIEW ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---
<!doctype html>
<html lang="fr-FR" data-sitemap={noindex ? 'no' : 'yes'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content={pageType === 'ItemPage' ? 'product' : 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(image)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={u('/favicon.ico')} sizes="48x48" />
    <link rel="apple-touch-icon" href={u('/images/apple-touch-icon.png')} />
    <link rel="sitemap" href={u('/sitemap.xml')} />
    <meta name="theme-color" content="#2C2C2A" />
    <script type="application/ld+json" set:html={jsonLd} />
    <script type="application/json" id="shop-data" set:html={shopData} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Aller au contenu</a>
    {PREVIEW && <div class="preview-bar">Version de test, non indexée : aucune commande ni demande n’est transmise. Les mentions en jaune restent à valider.</div>}
    <Header current={path} over={over} />
    <main id="main"><slot /></main>
    <Footer />
    <CartDrawer />
    <script>import '../scripts/shop.ts';</script>
  </body>
</html>
